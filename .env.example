# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=patent_matching

# Embeddings
# Possible values: true, false
GENERATE_EMBEDDINGS=false

# Possible values: openai, sentence_transformers, ollama
EMBEDDING_PROVIDER=openai

# Use one model compatible with the selected provider.
# openai examples: text-embedding-3-small, text-embedding-3-large
# sentence_transformers examples:
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#   intfloat/multilingual-e5-base
#   intfloat/multilingual-e5-large
#   sentence-transformers/all-MiniLM-L6-v2
# ollama examples:
#   nomic-embed-text
#   mxbai-embed-large
EMBEDDING_MODEL=text-embedding-3-small

# Required only when EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# Used only when EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Optional for EMBEDDING_PROVIDER=sentence_transformers.
# Possible values depend on the runtime: cpu, cuda, mps. Leave empty for auto.
SENTENCE_TRANSFORMERS_DEVICE=
